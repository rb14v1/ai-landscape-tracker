# ============================================================
# Ai-Tracker -- environment variable reference
# Copy this file to .env and fill in the values for your local
# environment.  Never commit .env to source control.
# ============================================================

# ------------------------------------------------------------
# Crawler output
# Path (relative to the crawler/ directory) where entries.json
# is written by the crawler.
# ------------------------------------------------------------
CRAWLER_OUTPUT_PATH=../data/entries.json

# ------------------------------------------------------------
# Crawler behaviour
# ------------------------------------------------------------
# Seconds to wait between outbound HTTP requests (float)
CRAWLER_DELAY_BETWEEN_REQUESTS=1

# Maximum number of retry attempts for a failed request
CRAWLER_MAX_RETRIES=3

# HTTP request timeout in seconds
CRAWLER_TIMEOUT=30

# ------------------------------------------------------------
# Backfill settings
# ------------------------------------------------------------
# Set to true to enable historical backfill, false to disable
CRAWLER_BACKFILL_ENABLED=true

# ISO date (YYYY-MM-DD) -- earliest date included in a backfill run
CRAWLER_BACKFILL_START_DATE=2024-01-01

# ------------------------------------------------------------
# Data processing scripts
# Paths used by summarize_entries.py and process_entries_basic.py
# (relative to the project root, or absolute)
# ------------------------------------------------------------
# Input file: raw crawled entries
DATA_INPUT_PATH=site/data/entries raw.json

# Output file: processed entries with summaries and categories
DATA_OUTPUT_PATH=site/data/entries.json
