# ─── Harbour SSO / OIDC ─────────────────────────────────────────────────────
# These values must be set in the deployment environment.
# Never commit actual secrets — use a secrets manager or CI/CD secret store.

OIDC_ISSUER=https://your-issuer.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# ─── Crawler ─────────────────────────────────────────────────────────────────
# Output path for crawled entries JSON file (overrides config.yaml output.path)
CRAWLER_OUTPUT_PATH=

# Seconds to wait between outbound HTTP requests (float; overrides config.yaml)
CRAWLER_DELAY_BETWEEN_REQUESTS=

# Maximum number of retries for failed HTTP requests (int; overrides config.yaml)
CRAWLER_MAX_RETRIES=

# HTTP request timeout in seconds (int; overrides config.yaml)
CRAWLER_TIMEOUT=

# Enable historical backfill run: set to "true", "1", or "yes" to enable
CRAWLER_BACKFILL_ENABLED=

# Earliest date (YYYY-MM-DD) to include when backfill is enabled
CRAWLER_BACKFILL_START_DATE=

# ─── Metrics ─────────────────────────────────────────────────────────────────
# Port on which the Prometheus /metrics HTTP server listens (default: 8000)
METRICS_PORT=

# ─── Data Processing ─────────────────────────────────────────────────────────
# Path to the raw input entries JSON file read by process_entries_basic.py and summarize_entries.py
DATA_INPUT_PATH=

# Path to the processed output entries JSON file written by process_entries_basic.py and summarize_entries.py
DATA_OUTPUT_PATH=
